      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_PREFIX_PATH": "/ucrt64"
      },
      "binaryDir": "${sourceDir}/build/WindowsNormalDebug"
